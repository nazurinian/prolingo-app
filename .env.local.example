# Copy to .env.local for local development. Never commit real secrets.
# Owner Gemini key is server-only and is never sent to the browser.
GEMINI_OWNER_API_KEY=

# One-time code used on the owner's browser to create a secure HttpOnly owner session.
PROLINGO_OWNER_ACCESS_CODE=

# Long random secret used to sign the owner-session cookie.
PROLINGO_OWNER_SESSION_SECRET=

# Optional: keep current model unless intentionally migrated after runtime testing.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Long random server-only secret used to encrypt each user BYOK key in an HttpOnly cookie.
PROLINGO_GEMINI_BYOK_SECRET=
